---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | jsonify }},
      "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
      "words": {{ post.content | number_of_words | jsonify }},
      "excerpt": {{ post.description | default: post.excerpt | default: post.content | strip_html | strip_newlines | truncate: 180 | jsonify }},
      "tags": [
        {% if post.tags %}
          {% for tag in post.tags %}
            {{ tag | strip | jsonify }}{% unless forloop.last %},{% endunless %}
          {% endfor %}
        {% elsif post.tag %}
          {{ post.tag | strip | jsonify }}
        {% endif %}
      ]
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
